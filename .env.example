APP_NAME="FRWRD Tutors"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin_frwrdlive
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@frwrdtutor.com"
MAIL_FROM_NAME="FRWRD Tutor"
EMAIL_ADMIN=support@myfrwrd.com

# N-Genius Payment Gateway
OUTLET_ID=
API_KEY=
NGENIUS_BASE_URL=https://api-gateway.ngenius-payments.com
NGENIUS_REDIRECT_URL=https://api.frwrdtutors.com/api/success
NGENIUS_CANCEL_URL=https://api.frwrdtutors.com/api/cancel
NGENIUS_FAILED_URL=https://api.frwrdtutors.com/api/failed
FRONTEND_SUCCESS_URL=https://app.frwrdtutors.com/success
FRONTEND_FAILED_URL=https://app.frwrdtutors.com/failed

# TutorCruncher
TUTORCRUNCHER_BASE_URL=https://app.tutorcruncher.com/api

# Stripe
STRIPE_SECRET_KEY=

# JWT Secret
JWT_SECRET=secret_key
